rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    function ownsTicket(ticketId) {
      return get(
        /databases/$(database)/documents/tickets/$(ticketId)
      ).data.createdBy.uid == request.auth.uid;
    }

    // Users
    match /users/{uid} {
      allow read: if signedIn() &&
        (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.role == 'employee';

      allow update: if isAdmin();
    }

    // Tickets
    match /tickets/{ticketId} {
      allow read: if signedIn() &&
        (isAdmin() ||
        resource.data.createdBy.uid == request.auth.uid);

      allow create: if signedIn() &&
        request.resource.data.createdBy.uid == request.auth.uid &&
        request.resource.data.status == 'Open';

      allow update, delete: if isAdmin();

      // Ticket comments
      match /comments/{commentId} {
        allow read: if signedIn() &&
          (isAdmin() || ownsTicket(ticketId));

        allow create: if signedIn() &&
          request.resource.data.by.uid == request.auth.uid &&
          (isAdmin() || ownsTicket(ticketId));
      }
    }

    // Assets
    match /assets/{assetId} {
      allow read: if signedIn() &&
        (isAdmin() ||
        resource.data.assignedTo.uid == request.auth.uid);

      allow write: if isAdmin();
    }
  }
}